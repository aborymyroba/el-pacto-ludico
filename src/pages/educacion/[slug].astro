---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('educacion');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const pageTitle = `${d.palabra} — Arsenal de Precisión Lingüística | El Pacto Lvdico`;
---

<Layout
  title={pageTitle}
          description={d.significado[0]}
  ogType="article"
>
  <div class="pt-32 pb-24 min-h-screen bg-background relative overflow-hidden">
    <!-- Background Decor -->
    <div class="fixed top-0 right-0 w-1/2 h-full opacity-5 pointer-events-none">
      <svg viewBox="0 0 100 100" fill="none" class="w-full h-full text-primary scale-150 transform translate-x-1/4 -translate-y-1/4">
        <path d="M50 0 C60 40 100 50 100 50 C60 60 50 100 50 100 C40 60 0 50 0 50 C40 40 50 0 50 0 Z" fill="currentColor" />
      </svg>
    </div>

    <article class="max-w-3xl mx-auto px-6 relative z-10">

      <!-- Header -->
      <header class="mb-16 text-center border-b border-border/50 pb-12">
        <div class="inline-flex items-center gap-3 px-4 py-2 border border-border bg-card rounded-full mb-8">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          <span class="text-xs tracking-[0.2em] uppercase font-semibold text-foreground/80">
            Arsenal de Precisión Lingüística · Entrada #{d.entrada}
          </span>
        </div>

        <h1 class="font-display text-6xl md:text-8xl text-primary mb-6 capitalize tracking-tight">
          {d.palabra}
        </h1>

        <div class="flex flex-wrap justify-center gap-4 items-center font-display text-foreground/70">
          <span class="text-xl md:text-2xl italic bg-card px-4 py-1 rounded-sm border border-border">{d.pronunciacion}</span>
          <span class="w-2 h-2 rounded-full bg-primary/50 hidden md:block"></span>
          <span class="text-sm md:text-base tracking-wider uppercase text-foreground/60">{d.categoria}</span>
        </div>
      </header>

      <!-- Content Body -->
      <div class="space-y-20 font-light text-lg md:text-xl text-foreground/80 leading-relaxed">

        <!-- Significado -->
        <section>
          <h2 class="font-display text-3xl text-foreground mb-6 flex items-center gap-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            Significado
          </h2>
          <div class="space-y-4">
            {d.significado.map((text: string, i: number) => (
              <p class:list={[i === 0 ? "text-2xl text-foreground font-normal leading-snug" : ""]}>
                {text}
              </p>
            ))}
          </div>
        </section>

        <!-- Qué aporta -->
        <section class="bg-card/50 border border-border/50 p-8 md:p-10 rounded-sm">
          <h2 class="font-display text-2xl text-primary mb-6 flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
            ¿Qué aporta que no aporten otras palabras?
          </h2>
          <p class="mb-6">Piensa en estas frases:</p>
          <ul class="space-y-3 mb-8 pl-6 border-l-2 border-primary/30">
            {d.valueAdd.comparisons.map((comp: string) => (
              <li class="italic text-foreground/70">«{comp}»</li>
            ))}
          </ul>
          <div class="space-y-4 whitespace-pre-line text-foreground/90 font-medium">
            {d.valueAdd.explanation}
          </div>
        </section>

        <!-- Etimología -->
        <section>
          <h2 class="font-display text-3xl text-foreground mb-6 flex items-center gap-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg>
            Etimología
          </h2>
          <div class="prose prose-invert prose-lg max-w-none prose-p:leading-relaxed">
            <p>{d.etymology.root}</p>
            <p>{d.etymology.verb}</p>
            <blockquote class="border-l-4 border-primary bg-primary/5 p-6 rounded-r-sm not-italic mt-6">
              <p class="font-display text-xl text-foreground mb-0">{d.etymology.conclusion}</p>
            </blockquote>
          </div>
        </section>

        <!-- Familia Léxica & Verbos -->
        <div class="grid md:grid-cols-2 gap-12">
          <section>
            <h2 class="font-display text-2xl text-foreground mb-6">Familia léxica</h2>
            <div class="space-y-6">
              {d.lexicalFamily.map((item: any) => (
                <div class="bg-card border border-border p-5">
                  <div class="flex items-baseline gap-3 mb-2">
                    <h3 class="font-display text-xl text-primary">{item.word}</h3>
                    <span class="text-xs uppercase tracking-widest text-foreground/50">{item.type}</span>
                  </div>
                  <p class="text-sm md:text-base mb-3">{item.desc}</p>
                  {item.example && (
                    <p class="text-sm italic text-foreground/60 border-l-2 border-border pl-3">«{item.example}»</p>
                  )}
                </div>
              ))}
            </div>
          </section>

          <section>
            <h2 class="font-display text-2xl text-foreground mb-6">¿Existe un verbo?</h2>
            <p class="mb-4 text-base">{d.verbs.desc}</p>
            <ul class="space-y-3">
              {d.verbs.list.map((verb: string) => (
                <li class="flex items-center gap-3 text-base">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0"><path d="m9 18 6-6-6-6"/></svg>
                  {verb}
                </li>
              ))}
            </ul>

            <h2 class="font-display text-2xl text-foreground mb-4 mt-12">Colocaciones naturales</h2>
            <div class="flex flex-wrap gap-2">
              {d.collocations.map((col: string) => (
                <span class="px-3 py-1 bg-card border border-border text-sm rounded-full">
                  {col}
                </span>
              ))}
            </div>
          </section>
        </div>

        <!-- La Palabra Rival -->
        <section>
          <h2 class="font-display text-3xl text-foreground mb-8 flex items-center gap-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M14.5 17.5 3 6 3 3 6 3 17.5 14.5"/><path d="m16 16 6 6"/><path d="m8 8-6-6"/><path d="m16 8 6-6"/><path d="m8 16-6 6"/></svg>
            La palabra rival
          </h2>
          <div class="grid md:grid-cols-2 gap-px bg-border border border-border">
            <div class="bg-background p-8 md:p-10">
              <h3 class="font-display text-2xl text-foreground/50 mb-4">{d.rival.word}</h3>
              <p class="text-base text-foreground/70">{d.rival.rivalDesc}</p>
            </div>
            <div class="bg-primary/5 p-8 md:p-10">
              <h3 class="font-display text-2xl text-primary mb-4">{d.palabra}</h3>
              <p class="text-base text-foreground/90 font-medium">{d.rival.mainDesc}</p>
            </div>
          </div>
          <p class="mt-6 text-center font-display text-xl text-foreground/80 italic">
            {d.rival.conclusion}
          </p>
        </section>

        <!-- Errores Frecuentes -->
        <section class="bg-[#1a1412] p-8 md:p-10 border border-red-900/30">
          <h2 class="font-display text-2xl text-red-400 mb-8 flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" x2="9" y1="9" y2="15"/><line x1="9" x2="15" y1="9" y2="15"/></svg>
            Errores frecuentes
          </h2>
          <div class="space-y-8">
            {d.mistakes.map((mistake: any) => (
              <div class="flex gap-4 items-start">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-500/50 mt-1 shrink-0"><circle cx="12" cy="12" r="10"/><line x1="15" x2="9" y1="9" y2="15"/><line x1="9" x2="15" y1="9" y2="15"/></svg>
                <div>
                  <h3 class="text-foreground font-medium mb-2">{mistake.mistake}</h3>
                  <p class="text-base text-foreground/70">{mistake.correction}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Ejemplos -->
        <section>
          <h2 class="font-display text-3xl text-foreground mb-8 flex items-center gap-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V21c0 0 0 0 0 0"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 0 0 0 0 0"/></svg>
            Ejemplos de uso
          </h2>
          <div class="grid gap-6">
            {d.examples.map((ex: any) => (
              <div class="bg-card p-6 border-l-2 border-primary/50 flex flex-col md:flex-row gap-4 md:items-center">
                <span class="text-xs uppercase tracking-widest text-primary font-semibold md:w-48 shrink-0">
                  {ex.context}
                </span>
                <p class="text-lg italic text-foreground/80">«{ex.text}»</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Reflexiones -->
        <section class="border-t border-border pt-16">
          <h2 class="font-display text-3xl text-foreground mb-6 flex items-center gap-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"/><path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"/><path d="M17.599 6.5a3 3 0 0 0 .399-1.375"/><path d="M6.003 5.125A3 3 0 0 0 6.401 6.5"/><path d="M3.477 10.896a4 4 0 0 1 .585-.396"/><path d="M19.938 10.5a4 4 0 0 1 .585.396"/><path d="M6 18a4 4 0 0 1-1.967-.516"/><path d="M19.967 17.484A4 4 0 0 1 18 18"/></svg>
            ¿Por qué conservar esta palabra?
          </h2>
          <div class="space-y-6">
            <p>{d.whyKeep.intro}</p>
            <p class="font-display text-xl text-primary italic text-center py-6">
              {d.whyKeep.contrast}
            </p>
            <p>{d.whyKeep.conclusion}</p>
          </div>
        </section>

        <!-- Observation (from markdown body) -->
        <section>
          <div class="bg-card/30 p-8 border border-border/50">
            <h3 class="text-xs uppercase tracking-widest text-primary mb-4 font-semibold">Una observación interesante</h3>
            <div class="prose prose-invert prose-sm max-w-none text-foreground/80 leading-relaxed">
              <Content />
            </div>
          </div>
        </section>

        <!-- Frase memorable -->
        <section class="text-center py-20">
          <div class="w-16 h-px bg-primary/50 mx-auto mb-10"></div>
          <blockquote class="font-display text-3xl md:text-5xl text-foreground leading-tight max-w-4xl mx-auto">
            «{d.memorablePhrase}»
          </blockquote>
          <div class="w-16 h-px bg-primary/50 mx-auto mt-10"></div>
        </section>

      </div>
    </article>
  </div>

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": `${d.palabra} — Arsenal de Precisión Lingüística`,
    "author": {
      "@type": "Organization",
      "name": "El Pacto Lvdico"
    },
    "publisher": {
      "@type": "Organization",
      "name": "El Pacto Lvdico",
      "url": "https://pactolvdico.com"
    },
    "datePublished": new Date().toISOString().split('T')[0],
    "inLanguage": "es",
    "description": d.significado[0]
  })} />
</Layout>
