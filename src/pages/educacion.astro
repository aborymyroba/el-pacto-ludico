---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Educación — El Pacto Lvdico"
  description="El juego como herramienta de aprendizaje. Talleres, seminarios y academias lúdicas."
  ogType="website"
>
  <div class="pt-32 pb-24 min-h-screen bg-background relative overflow-hidden">
    <!-- Background Decor -->
    <div class="fixed top-0 right-0 w-1/2 h-full opacity-5 pointer-events-none">
      <svg viewBox="0 0 100 100" fill="none" class="w-full h-full text-primary scale-150 transform translate-x-1/4 -translate-y-1/4">
        <path d="M50 0 C60 40 100 50 100 50 C60 60 50 100 50 100 C40 60 0 50 0 50 C40 40 50 0 50 0 Z" fill="currentColor" />
      </svg>
    </div>

    <div class="max-w-4xl mx-auto px-6 relative z-10">
      <!-- Header -->
      <header class="mb-16 text-center">
        <h1 class="font-display text-4xl md:text-6xl text-foreground mb-4">
          Educación
        </h1>
        <div class="w-16 h-1 bg-primary mx-auto mb-6"></div>
        <p class="text-foreground/60 text-lg font-light leading-relaxed max-w-2xl mx-auto">
          El juego como herramienta de aprendizaje. Talleres, seminarios y academias lúdicas para formar mentes brillantes.
        </p>
      </header>

      <!-- Content -->
      <div class="flex flex-col items-center justify-center py-16">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary/40 mb-6">
          <path d="M12 7v14"/>
          <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>
        </svg>
        <h2 class="font-display text-2xl text-foreground/60 mb-3">Próximamente</h2>
        <p class="text-foreground/40 text-center font-light leading-relaxed max-w-md">
          Esta sección está en preparación. Volveremos con talleres, seminarios y programas de formación lúdica.
        </p>
      </div>
    </div>
  </div>
</Layout>
