---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('ecos');
entries.sort((a, b) => a.data.numero - b.data.numero);

const roman = (n: number): string =>
  ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'][n - 1] ?? String(n);
---

<Layout
  title="Educación — El Pacto Lúdico"
  description="El juego como herramienta de aprendizaje. Talleres, seminarios y academias lúdicas."
  ogType="website"
>
  <div class="pt-32 pb-24 min-h-screen bg-background relative overflow-hidden">
    <!-- Background Decor -->
    <div class="fixed top-0 right-0 w-1/2 h-full opacity-5 pointer-events-none">
      <svg viewBox="0 0 100 100" fill="none" class="w-full h-full text-primary scale-150 transform translate-x-1/4 -translate-y-1/4">
        <path d="M50 0 C60 40 100 50 100 50 C60 60 50 100 50 100 C40 60 0 50 0 50 C40 40 50 0 50 0 Z" fill="currentColor" />
      </svg>
    </div>

    <div class="max-w-4xl mx-auto px-6 relative z-10">
      <!-- Header -->
      <header class="mb-16 text-center">
        <h1 class="font-display text-4xl md:text-6xl text-foreground mb-4">
          Educación
        </h1>
        <div class="w-16 h-1 bg-primary mx-auto mb-6"></div>
        <p class="text-foreground/60 text-lg font-light leading-relaxed max-w-2xl mx-auto mb-8">
          El juego como herramienta de aprendizaje. Talleres, seminarios y academias lúdicas para formar mentes brillantes.
        </p>

        <!-- Tab Navigation -->
        <nav class="flex justify-center gap-8 border-b border-border pb-4">
          <a href="/educacion" class="text-sm tracking-widest uppercase text-primary border-b-2 border-primary pb-4 -mb-[18px]">
            Ecos
          </a>
        </nav>
      </header>

      <!-- Voces List -->
      <div class="mt-12">
        {entries.length === 0 ? (
          <div class="text-center py-20">
            <p class="text-foreground/40 text-lg">No hay voces disponibles aún.</p>
          </div>
        ) : (
          <div class="grid gap-4">
            {entries.map((entry) => (
              <a
                href={`/educacion/ecos/${entry.id}`}
                class="group block bg-card border border-border p-6 hover:border-primary/50 transition-colors duration-300"
              >
                <div class="flex items-center gap-6">
                  <span class="text-xs tracking-[0.2em] uppercase font-semibold text-foreground/50 shrink-0">
                    Voz {roman(entry.data.numero)}
                  </span>
                  <h2 class="font-display text-2xl text-primary group-hover:text-foreground transition-colors uppercase">
                    {entry.data.titulo}
                  </h2>
                  <div class="ml-auto shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary opacity-0 group-hover:opacity-100 transition-opacity"><path d="m9 18 6-6-6-6"/></svg>
                  </div>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>
