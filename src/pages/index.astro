---
import Layout from '../layouts/Layout.astro';
import WhatsAppCta from '../components/WhatsAppCta.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/format';
import { todasLasPublicaciones } from '../lib/publicaciones';

const entregas = await getCollection('entregas');
const ecos = await getCollection('ecos');
const publicaciones = todasLasPublicaciones(entregas, ecos);
const ultimaPublicacion = publicaciones[0] ?? null;

const chevronRight = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>';
const circleDollar = '<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-primary mx-auto mb-8 opacity-50"><circle cx="12" cy="12" r="10"/><path d="m16 10-4 4-4-4"/></svg>';

const pillars = [
  {
    title: 'La Orden',
    subtitle: 'Un Colectivo con Propósito',
    description: 'Los juegos de mesa y de rol no son solo un pasatiempo, sino una lucha colectiva para atender una necesidad que los medios ordinarios no cubren. Esta sociedad es un espacio de unión sin ánimo de lucro.',
    phrase: 'Una sociedad civil creada para conservar, difundir y hacer accesible la cultura del juego.',
  },
  {
    title: 'Acceso Libre',
    subtitle: 'Espacio Comunitario',
    description: 'Buscamos democratizar el entretenimiento y el aprendizaje. La orden busca garantizar un lugar gratuito donde cualquiera pueda jugar, proponer ideas y compartir con otros.',
    phrase: 'Un espacio gratuito de encuentro, juego y creación para todas las personas.',
  },
  {
    title: 'El Juego en Todas las Etapas',
    subtitle: 'Más Allá de la Niñez',
    description: 'Desmitificar la idea de que "jugar es solo para niños". El juego es aprendizaje estructurado desde la infancia y una herramienta fundamental de relajación, desconexión y bienestar para los adultos.',
    phrase: 'Herramienta de aprendizaje, desconexión y bienestar a cualquier edad.',
  },
  {
    title: 'Imaginación y Conexión Humana',
    subtitle: 'Creatividad y Empatía',
    description: 'Inspirado en la cita de Schiller: "El hombre solo es verdaderamente humano cuando juega". El juego estimula la capacidad de fantasear, crear mundos propios y conectar profundamente con la gente.',
    phrase: 'Creatividad, narrativa, aprendizaje continuo y empatía social.',
  },
];
---

<Layout
  title="El Pacto Lúdico — Juegos de Mesa, Rol y Educación"
  description="Explora las fronteras de la imaginación a través de los juegos de mesa, la narrativa de rol y la educación lúdica."
  ogType="website"
>
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center pt-20">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-gradient-to-b from-background/40 via-background/80 to-background z-10"></div>
      <img
        src="/images/hero-colosseum.jpg"
        alt="Roman Colosseum"
        class="w-full h-full object-cover object-center opacity-40 grayscale-[20%]"
      />
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 w-full grid lg:grid-cols-2 gap-12 items-center">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-primary/30 bg-primary/5 backdrop-blur-sm mb-8">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          <span class="text-xs uppercase tracking-[0.2em] text-primary">
            Uniendo Mundos
          </span>
        </div>
        <h1 class="font-display text-5xl md:text-7xl lg:text-8xl leading-[1.1] mb-6 tracking-tight">
          <span class="block text-foreground">El Pacto</span>
          <span class="block text-primary italic">Lvdico</span>
        </h1>
        <p class="text-lg md:text-xl text-foreground/70 leading-relaxed mb-10 max-w-lg font-light">
          Explora las fronteras de la imaginación a través de los juegos de
          mesa, la narrativa de rol y la educación lúdica.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="#explorar"
            class="px-8 py-4 bg-primary text-primary-foreground font-display tracking-widest uppercase text-sm font-semibold hover:bg-white hover:text-primary-foreground transition-colors duration-300 flex items-center gap-2"
          >
            Descubrir <span set:html={chevronRight} />
          </a>
          <a
            href="#nosotros"
            class="px-8 py-4 border border-border text-foreground font-display tracking-widest uppercase text-sm hover:border-primary hover:text-primary transition-colors duration-300"
          >
            La Orden
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Última publicación -->
  {ultimaPublicacion && (
    <section class="py-24 bg-background">
      <div class="max-w-4xl mx-auto px-6">
        <div class="bg-card border border-border p-10">
          <div class="flex items-center gap-3 mb-8">
            <span class="w-2 h-2 rounded-full bg-primary"></span>
            <span class="text-xs uppercase tracking-[0.2em] text-primary">
              Última publicación
            </span>
          </div>

          <div class="flex items-center gap-3 mb-4">
            <span class="text-xs tracking-[0.2em] uppercase font-semibold text-foreground/40">
              {ultimaPublicacion.etiqueta}
            </span>
            <span class="text-foreground/30 text-xs">·</span>
            <span class="text-xs tracking-[0.2em] uppercase text-foreground/40">
              {formatDate(ultimaPublicacion.fecha)}
            </span>
          </div>

          <h2 class="font-display text-4xl md:text-6xl text-primary mb-6 tracking-tight capitalize">
            {ultimaPublicacion.palabra ?? ultimaPublicacion.titulo}
          </h2>

          <p class="text-foreground/60 font-light leading-relaxed mb-10 max-w-2xl">
            {ultimaPublicacion.extracto}
          </p>

          <a
            href={ultimaPublicacion.ruta}
            class="inline-flex items-center gap-2 px-8 py-4 bg-primary text-primary-foreground font-display tracking-widest uppercase text-sm font-semibold hover:bg-white hover:text-primary-foreground transition-colors duration-300"
          >
            Leer <span set:html={chevronRight} />
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Presentación -->
  <section id="nosotros" class="py-24 bg-card border-y border-border">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="font-display text-3xl md:text-5xl mb-6 text-foreground">
          Presentación
        </h2>
        <div class="w-16 h-1 bg-primary mx-auto mb-6"></div>
      </div>

      <div class="text-lg md:text-xl text-foreground/70 font-light leading-loose text-pretty hyphens-auto space-y-8 mb-16">
        <p>
          Como iremos descubriendo, los juegos no son únicamente cosa de niños. Han acompañado al ser humano desde las primeras civilizaciones y, a lo largo de la historia, han servido como herramientas de aprendizaje dentro de entornos definidos por reglas y objetivos. Pero jugar es mucho más que entretenerse: es explorar posibilidades, asumir retos, imaginar, aprender y relacionarnos con los demás.
        </p>
        <p>
          Jugar no es evadirse de la vida, sino una forma particular de vivirla. Podemos hacerlo moviendo piezas, asumiendo personajes, resolviendo problemas o explorando las posibilidades del lenguaje. Siempre hay en el juego algo que nos entretiene, algo que nos enseña y, sobre todo, algo que amplía nuestra manera de mirar y comprender el mundo.
        </p>
      </div>

      <img
        src="/images/maldon.webp"
        alt="Imagen de la presentación de El Pacto Lúdico"
        class="w-full h-auto border border-border mb-16"
        loading="lazy"
      />

      <div class="text-lg md:text-xl text-foreground/70 font-light leading-loose text-pretty hyphens-auto">
        <p>
          Conocimos esta frase a través de Juegos Maldón, donde aparece como una de las ideas que inspiraron su proyecto. La encuentro especialmente apropiada para este lugar: porque jugar no pertenece a una edad determinada. Es una forma de explorar, aprender, crear, compartir y mantener abierta nuestra manera de mirar el mundo.
        </p>
      </div>
    </div>
  </section>

  <!-- Los Cuatro Pilares -->
  <section id="explorar" class="py-32 relative z-10 bg-background">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-20">
        <h2 class="font-display text-3xl md:text-5xl mb-6 text-foreground">
          Los Cuatro Pilares
        </h2>
        <div class="w-16 h-1 bg-primary mx-auto mb-6"></div>
        <p class="text-foreground/70 text-lg font-light leading-relaxed">
          Los cimientos sobre los que se sostiene El Pacto Lúdico.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {pillars.map((pillar) => (
          <div class="bg-card border border-border p-10 flex flex-col hover:border-primary/50 transition-colors duration-500">
            <h3 class="font-display text-2xl text-primary mb-2">{pillar.title}</h3>
            <p class="text-xs uppercase tracking-[0.2em] text-foreground/40 mb-6">{pillar.subtitle}</p>
            <p class="text-foreground/70 leading-relaxed font-light mb-8 flex-1">
              {pillar.description}
            </p>
            <blockquote class="border-l-2 border-primary/40 pl-4 text-foreground/50 italic text-sm">
              "{pillar.phrase}"
            </blockquote>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Canal de WhatsApp -->
  <section class="py-16 bg-background">
    <div class="max-w-3xl mx-auto px-6">
      <WhatsAppCta>
        <p class="text-foreground/70 text-lg font-light leading-relaxed mb-8">
          Sigamos construyendo conocimiento, únete al canal y no te pierdas ninguna publicación.
        </p>
      </WhatsAppCta>
    </div>
  </section>

  <!-- Juegos de Mesa -->
  <section id="mesa" class="py-24 bg-card border-y border-border">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="font-display text-3xl md:text-5xl mb-6 text-foreground">Juegos de Mesa</h2>
        <div class="w-16 h-1 bg-primary mx-auto mb-6"></div>
        <p class="text-foreground/70 text-lg font-light leading-relaxed">
          Contenido en preparación.
        </p>
      </div>
    </div>
  </section>

  <!-- Juegos de Rol -->
  <section id="rol" class="py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="font-display text-3xl md:text-5xl mb-6 text-foreground">Juegos de Rol</h2>
        <div class="w-16 h-1 bg-primary mx-auto mb-6"></div>
        <p class="text-foreground/70 text-lg font-light leading-relaxed">
          Contenido en preparación.
        </p>
      </div>
    </div>
  </section>

  <!-- Quote / Interstitial -->
  <section class="py-32 relative border-y border-border overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/images/quote-texture.jpg"
        alt="Roman Architecture Texture"
        class="w-full h-full object-cover opacity-10"
      />
      <div class="absolute inset-0 bg-background/90"></div>
    </div>
    <div class="max-w-4xl mx-auto px-6 relative z-10 text-center">
      <span set:html={circleDollar} />
      <blockquote class="font-display text-3xl md:text-5xl leading-tight text-foreground mb-8">
        "En la mesa de juego, como en el senado, se revelan los verdaderos
        temperamentos de los hombres."
      </blockquote>
      <cite class="text-primary tracking-[0.3em] uppercase text-sm font-display not-italic">
        — El Primer Edicto
      </cite>
    </div>
  </section>

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "El Pacto Lúdico",
    "url": "https://el-pacto-ludico.web.app",
    "description": "Una sociedad civil creada para conservar, difundir y hacer accesible la cultura del juego. Juegos de mesa, juegos de rol, arsenal lingüístico y educación lúdica.",
    "logo": "https://el-pacto-ludico.web.app/images/coin.webp",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "fportiz.abg@gmail.com",
      "contactType": "customer service",
      "areaServed": "es_CO",
      "availableLanguage": "Spanish"
    }
  })} />
</Layout>
