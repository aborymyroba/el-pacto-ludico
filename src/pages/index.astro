---
import Layout from '../layouts/Layout.astro';
import PillarCard from '../components/PillarCard.astro';

const icons = {
  dices: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><path d="M16 8h.01"/><path d="M12 12h.01"/><path d="M8 8h.01"/><path d="M12 16h.01"/><path d="M8 16h.01"/><path d="M8 12h.01"/></svg>',
  sword: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"/><line x1="13" x2="19" y1="19" y2="13"/><line x1="16" x2="20" y1="16" y2="20"/><line x1="19" x2="21" y1="21" y2="19"/></svg>',
  bookOpen: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>',
  library: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>',
  chevronRight: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>',
  circleDollar: '<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-primary mx-auto mb-8 opacity-50"><circle cx="12" cy="12" r="10"/><path d="m16 10-4 4-4-4"/></svg>',
};
---

<Layout
  title="El Pacto Lvdico — Juegos de Mesa, Rol, Literatura y Educación"
  description="Explora las fronteras de la imaginación a través de los juegos de mesa, la narrativa de rol, la literatura clásica y la educación lúdica."
  ogType="website"
>
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center pt-20">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-gradient-to-b from-background/40 via-background/80 to-background z-10"></div>
      <img
        src="/images/hero-colosseum.jpg"
        alt="Roman Colosseum"
        class="w-full h-full object-cover object-center opacity-40 grayscale-[20%]"
      />
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 w-full grid lg:grid-cols-2 gap-12 items-center">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-primary/30 bg-primary/5 backdrop-blur-sm mb-8">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          <span class="text-xs uppercase tracking-[0.2em] text-primary">
            Uniendo Mundos
          </span>
        </div>
        <h1 class="font-display text-5xl md:text-7xl lg:text-8xl leading-[1.1] mb-6 tracking-tight">
          <span class="block text-foreground">El Pacto</span>
          <span class="block text-primary italic">Lvdico</span>
        </h1>
        <p class="text-lg md:text-xl text-foreground/70 leading-relaxed mb-10 max-w-lg font-light">
          Explora las fronteras de la imaginación a través de los juegos de
          mesa, la narrativa de rol, la literatura clásica y la educación
          lúdica.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="#explorar"
            class="px-8 py-4 bg-primary text-primary-foreground font-display tracking-widest uppercase text-sm font-semibold hover:bg-white hover:text-primary-foreground transition-colors duration-300 flex items-center gap-2"
          >
            Descubrir <span set:html={icons.chevronRight} />
          </a>
          <a
            href="#nosotros"
            class="px-8 py-4 border border-border text-foreground font-display tracking-widest uppercase text-sm hover:border-primary hover:text-primary transition-colors duration-300"
          >
            La Orden
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Los Cuatro Pilares -->
  <section id="explorar" class="py-32 relative z-10 bg-background">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-20">
        <h2 class="font-display text-3xl md:text-5xl mb-6 text-foreground">
          Los Cuatro Pilares
        </h2>
        <div class="w-16 h-1 bg-primary mx-auto mb-6"></div>
        <p class="text-foreground/70 text-lg font-light leading-relaxed">
          Nuestro pacto se sostiene sobre cuatro disciplinas fundamentales,
          cada una diseñada para enriquecer la mente y el espíritu.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <PillarCard
          id="mesa"
          title="Juegos de Mesa"
          icon={icons.dices}
          description="Estrategia, táctica y convivencia. Una colección curada de experiencias sobre el tablero."
          image="/images/pillar-mesa.jpg"
        />
        <PillarCard
          id="rol"
          title="Juegos de Rol"
          icon={icons.sword}
          description="Narrativa compartida. Forja tu propio destino en mundos de fantasía, ciencia ficción y misterio."
          image="/images/pillar-rol.jpg"
        />
        <PillarCard
          id="literatura"
          title="Literatura"
          icon={icons.bookOpen}
          description="Las crónicas del pasado y ficciones del futuro. Textos que inspiran nuestras aventuras."
          image="/images/pillar-literatura.jpg"
        />
        <PillarCard
          id="educacion"
          title="Educación"
          icon={icons.library}
          description="El juego como herramienta de aprendizaje. Talleres, seminarios y academias lúdicas."
          image="/images/pillar-educacion.jpg"
        />
      </div>
    </div>
  </section>

  <!-- Quote / Interstitial -->
  <section class="py-32 relative border-y border-border overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/images/quote-texture.jpg"
        alt="Roman Architecture Texture"
        class="w-full h-full object-cover opacity-10"
      />
      <div class="absolute inset-0 bg-background/90"></div>
    </div>
    <div class="max-w-4xl mx-auto px-6 relative z-10 text-center">
      <span set:html={icons.circleDollar} />
      <blockquote class="font-display text-3xl md:text-5xl leading-tight text-foreground mb-8">
        "En la mesa de juego, como en el senado, se revelan los verdaderos
        temperamentos de los hombres."
      </blockquote>
      <cite class="text-primary tracking-[0.3em] uppercase text-sm font-display not-italic">
        — El Primer Edicto
      </cite>
    </div>
  </section>

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "El Pacto Lvdico",
    "url": "https://pactolvdico.com",
    "description": "Explora las fronteras de la imaginación a través de los juegos de mesa, la narrativa de rol, la literatura clásica y la educación lúdica.",
    "logo": "https://pactolvdico.com/images/hero-colosseum.jpg",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "senado@pactolvdico.com",
      "contactType": "customer service",
      "areaServed": "es_AR",
      "availableLanguage": "Spanish"
    }
  })} />
</Layout>
