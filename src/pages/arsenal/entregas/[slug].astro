---
import Layout from '../../../layouts/Layout.astro';
import CommentSection from '../../../components/CommentSection.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../../lib/format';

export async function getStaticPaths() {
  const entries = await getCollection('entregas');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const pageTitle = `${d.titulo} — Arsenal de Precisión Lingüística | El Pacto Lúdico`;
---

<Layout
  title={pageTitle}
  description={d.palabra}
  ogType="article"
>
  <div class="pt-32 pb-24 min-h-screen bg-background relative overflow-hidden">
    <!-- Background Decor -->
    <div class="fixed top-0 right-0 w-1/2 h-full opacity-5 pointer-events-none">
      <svg viewBox="0 0 100 100" fill="none" class="w-full h-full text-primary scale-150 transform translate-x-1/4 -translate-y-1/4">
        <path d="M50 0 C60 40 100 50 100 50 C60 60 50 100 50 100 C40 60 0 50 0 50 C40 40 50 0 50 0 Z" fill="currentColor" />
      </svg>
    </div>

    <article class="max-w-3xl mx-auto px-6 relative z-10">

      <!-- Header -->
      <header class="mb-8 text-center">
        <h1 class="font-display text-4xl md:text-6xl text-foreground mb-4">
          Arsenal de Precisión Lingüística
        </h1>
        <div class="w-16 h-1 bg-primary mx-auto mb-8"></div>

        <!-- Tab Navigation -->
        <nav class="flex justify-center gap-8 border-b border-border pb-4">
          <a href="/arsenal" class="text-sm tracking-widest uppercase text-foreground/50 hover:text-foreground transition-colors pb-4 -mb-[18px]">
            Prólogo
          </a>
          <a href="/arsenal/entregas" class="text-sm tracking-widest uppercase text-primary border-b-2 border-primary pb-4 -mb-[18px]">
            Entregas
          </a>
          <a href="/arsenal/constelaciones" class="text-sm tracking-widest uppercase text-foreground/50 hover:text-foreground transition-colors pb-4 -mb-[18px]">
            Constelaciones
          </a>
        </nav>
      </header>

      <!-- Entry Header -->
      <header class="mb-16 text-center border-b border-border/50 pb-12">
        <div class="inline-flex items-center gap-3 px-4 py-2 border border-border bg-card rounded-full mb-8">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          <span class="text-xs tracking-[0.2em] uppercase font-semibold text-foreground/80">
            Arsenal de Precisión Lingüística · Entrega {d.numero}
          </span>
        </div>

        <h2 class="font-display text-6xl md:text-8xl text-primary mb-6 capitalize tracking-tight">
          {d.palabra}
        </h2>
        <p class="text-sm tracking-[0.2em] uppercase text-foreground/40">
          {formatDate(d.fecha)}
        </p>
      </header>

      <!-- Content Body -->
      <div class="prose prose-invert prose-xl max-w-none prose-headings:font-display prose-headings:text-foreground prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-6 prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-4 prose-p:text-foreground/80 prose-p:font-light prose-p:leading-relaxed prose-p:mb-8 prose-strong:text-foreground prose-em:text-foreground/70 prose-blockquote:border-primary prose-blockquote:bg-primary/5 prose-blockquote:rounded-r-sm prose-blockquote:not-italic prose-blockquote:pl-6">
        <Content />
      </div>

      <!-- Comments -->
      <CommentSection slug={entry.id} />

      <!-- Navigation -->
      <div class="mt-16 pt-8 border-t border-border/50 text-center">
        <a href="/arsenal/entregas" class="text-sm tracking-widest uppercase text-foreground/50 hover:text-primary transition-colors">
          ← Volver a Entregas
        </a>
      </div>
    </article>
  </div>
</Layout>
