---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página no encontrada — El Pacto Lúdico"
  description="La página que buscas no existe o fue movida."
  ogType="website"
>
  <div class="pt-32 pb-24 min-h-screen bg-background relative overflow-hidden">
    <div class="fixed top-0 right-0 w-1/2 h-full opacity-5 pointer-events-none">
      <svg viewBox="0 0 100 100" fill="none" class="w-full h-full text-primary scale-150 transform translate-x-1/4 -translate-y-1/4">
        <path d="M50 0 C60 40 100 50 100 50 C60 60 50 100 50 100 C40 60 0 50 0 50 C40 40 50 0 50 0 Z" fill="currentColor" />
      </svg>
    </div>

    <div class="max-w-3xl mx-auto px-6 relative z-10 text-center flex flex-col items-center justify-center min-h-[60vh]">
      <p class="font-display text-8xl md:text-9xl text-primary mb-8">404</p>
      <h1 class="font-display text-3xl md:text-5xl text-foreground mb-6">
        Página no encontrada
      </h1>
      <p class="text-foreground/60 text-lg font-light leading-relaxed mb-10 max-w-lg mx-auto">
        La página que buscas no existe o fue movida.
      </p>
      <a
        href="/"
        class="px-8 py-4 bg-primary text-primary-foreground font-display tracking-widest uppercase text-sm font-semibold hover:bg-white hover:text-primary-foreground transition-colors duration-300"
      >
        Volver al inicio
      </a>
    </div>
  </div>
</Layout>
