---
import '../index.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  ogImage = '/images/hero-colosseum.jpg',
  ogType = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://el-pacto-ludico.web.app');
const fullTitle = title.includes('El Pacto Lvdico') ? title : `${title} | El Pacto Lvdico`;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? 'https://el-pacto-ludico.web.app').href} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="El Pacto Lvdico" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? 'https://el-pacto-ludico.web.app').href} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />

    <!-- Google Search Console -->
    <meta name="google-site-verification" content="Hq_sh0_pN924x-bq0dmeZjEhnIPVW6tg_OWacYRWFz0" />

    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground overflow-x-hidden selection:bg-primary selection:text-primary-foreground">
    <!-- Navigation -->
    <nav
      id="main-nav"
      class="fixed top-0 w-full z-50 transition-all duration-500 border-b bg-transparent border-transparent py-6"
    >
      <div class="max-w-7xl mx-auto px-6 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div class="relative w-10 h-10 rounded-full overflow-hidden border-2 border-primary transition-transform duration-500 group-hover:rotate-180 bg-background/50">
            <img src="/images/coin.webp" alt="El Pacto Lvdico" class="w-full h-full object-cover" width="40" height="40" />
          </div>
          <span class="font-display font-semibold tracking-widest text-xl uppercase text-foreground group-hover:text-primary transition-colors">
            El Pacto Lvdico
          </span>
        </a>

        <!-- Desktop Nav -->
        <div class="hidden md:flex items-center gap-8">
          <a href="/" class="text-sm tracking-widest uppercase font-medium text-foreground/80 hover:text-primary transition-colors duration-300">Inicio</a>
          <a href="/arsenal" class="text-sm tracking-widest uppercase font-medium text-foreground/80 hover:text-primary transition-colors duration-300">Arsenal</a>
          <a href="/#mesa" class="text-sm tracking-widest uppercase font-medium text-foreground/80 hover:text-primary transition-colors duration-300">Juegos de mesa</a>
          <a href="/#rol" class="text-sm tracking-widest uppercase font-medium text-foreground/80 hover:text-primary transition-colors duration-300">Juegos de Rol</a>
          <a href="/educacion" class="text-sm tracking-widest uppercase font-medium text-foreground/80 hover:text-primary transition-colors duration-300">Educación</a>
          <a href="/acerca-de" class="text-sm tracking-widest uppercase font-medium text-foreground/80 hover:text-primary transition-colors duration-300">Acerca de</a>
        </div>

        <!-- Mobile Menu Toggle -->
        <button
          id="mobile-menu-toggle"
          class="md:hidden text-foreground hover:text-primary transition-colors"
          aria-label="Toggle menu"
        >
          <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
          <svg id="menu-icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="fixed inset-0 bg-background/95 backdrop-blur-xl z-40 transition-transform duration-500 flex flex-col items-center justify-center gap-8 -translate-y-full md:hidden"
    >
      <a href="/" class="mobile-menu-link font-display text-2xl tracking-widest uppercase text-foreground hover:text-primary transition-colors">Inicio</a>
      <a href="/arsenal" class="mobile-menu-link font-display text-2xl tracking-widest uppercase text-foreground hover:text-primary transition-colors">Arsenal</a>
      <a href="/#mesa" class="mobile-menu-link font-display text-2xl tracking-widest uppercase text-foreground hover:text-primary transition-colors">Juegos de mesa</a>
      <a href="/#rol" class="mobile-menu-link font-display text-2xl tracking-widest uppercase text-foreground hover:text-primary transition-colors">Juegos de Rol</a>
      <a href="/educacion" class="mobile-menu-link font-display text-2xl tracking-widest uppercase text-foreground hover:text-primary transition-colors">Educación</a>
      <a href="/acerca-de" class="mobile-menu-link font-display text-2xl tracking-widest uppercase text-foreground hover:text-primary transition-colors">Acerca de</a>
    </div>

    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-card pt-20 pb-10 border-t border-border mt-auto">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-4 gap-12 mb-16">
          <div class="col-span-1 md:col-span-2">
            <div class="flex items-center gap-3 mb-6">
              <img src="/images/coin.webp" alt="El Pacto Lvdico" class="w-8 h-8 rounded-full object-cover border border-primary" width="32" height="32" />
              <span class="font-display text-2xl tracking-widest uppercase text-foreground">
                El Pacto Lvdico
              </span>
            </div>
            <p class="text-foreground/60 leading-relaxed max-w-sm mb-8 font-light">
              Preservando la tradición del juego, la historia y el conocimiento para las generaciones venideras.
            </p>
          </div>

          <div>
            <h4 class="font-display text-primary tracking-widest uppercase text-sm mb-6">
              Secciones
            </h4>
            <ul class="space-y-4">
              <li><a href="/arsenal" class="text-foreground/70 hover:text-primary transition-colors text-sm uppercase tracking-wider">Arsenal</a></li>
              <li><a href="/#mesa" class="text-foreground/70 hover:text-primary transition-colors text-sm uppercase tracking-wider">Juegos de mesa</a></li>
              <li><a href="/#rol" class="text-foreground/70 hover:text-primary transition-colors text-sm uppercase tracking-wider">Juegos de Rol</a></li>
              <li><a href="/educacion" class="text-foreground/70 hover:text-primary transition-colors text-sm uppercase tracking-wider">Educación</a></li>
              <li><a href="/acerca-de" class="text-foreground/70 hover:text-primary transition-colors text-sm uppercase tracking-wider">Acerca de</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-display text-primary tracking-widest uppercase text-sm mb-6">
              Contacto
            </h4>
            <ul class="space-y-4 text-sm text-foreground/70 font-light">
              <li>Florencia, Caquetá - Colombia</li>
              <li>Correo: fportiz.abg@gmail.com</li>
              <li>Invítame un café: 3103394801</li>
            </ul>
          </div>
        </div>

        <div class="pt-8 border-t border-border text-xs uppercase tracking-widest text-foreground/40">
          <div class="flex flex-col md:flex-row justify-between items-center gap-4">
            <p>&copy; {new Date().getFullYear()} El Pacto Lvdico. Todos los derechos reservados.</p>
            <div class="flex gap-4">
              <a href="#" class="hover:text-primary transition-colors">Privacidad</a>
              <a href="#" class="hover:text-primary transition-colors">Términos</a>
            </div>
          </div>
          <p class="mt-6">Desarrollado por Iván Darío Calderón</p>
        </div>
      </div>
    </footer>

    <!-- Scroll-based nav styling -->
    <script is:inline>
      const nav = document.getElementById('main-nav');
      function updateNav() {
        if (window.scrollY > 20) {
          nav.classList.remove('bg-transparent', 'border-transparent', 'py-6');
          nav.classList.add('bg-background/95', 'backdrop-blur-md', 'border-border', 'py-4', 'shadow-lg');
        } else {
          nav.classList.add('bg-transparent', 'border-transparent', 'py-6');
          nav.classList.remove('bg-background/95', 'backdrop-blur-md', 'border-border', 'py-4', 'shadow-lg');
        }
      }
      window.addEventListener('scroll', updateNav);
      updateNav();
    </script>

    <!-- Mobile menu toggle -->
    <script is:inline>
      const toggle = document.getElementById('mobile-menu-toggle');
      const menu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');
      let menuOpen = false;

      function setMenuState(open) {
        menuOpen = open;
        if (open) {
          menu.classList.remove('-translate-y-full');
          menu.classList.add('translate-y-0');
          iconOpen.classList.add('hidden');
          iconClose.classList.remove('hidden');
        } else {
          menu.classList.add('-translate-y-full');
          menu.classList.remove('translate-y-0');
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
        }
      }

      toggle.addEventListener('click', () => setMenuState(!menuOpen));

      document.querySelectorAll('.mobile-menu-link').forEach(link => {
        link.addEventListener('click', () => setMenuState(false));
      });
    </script>

    <!-- Hash scroll on load -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const hash = window.location.hash;
        if (hash) {
          setTimeout(() => {
            const el = document.getElementById(hash.substring(1));
            if (el) el.scrollIntoView({ behavior: 'smooth' });
          }, 100);
        }
      });
    </script>

  </body>
</html>
